# -----------------------------
# Server identity
# -----------------------------
SERVER_NAME=prod-web-01
ENVIRONMENT=production

# -----------------------------
# Monitoring intervals (seconds)
# -----------------------------
HEALTH_INTERVAL=60
LOG_INTERVAL=15
# Maximum log lines consumed from each monitored file per cycle.
MAX_LOG_LINES_PER_CYCLE=250
# Maximum characters retained from one physical log line. Oversized lines are
# consumed safely and marked as truncated; they are never held in full memory.
MAX_LOG_LINE_CHARS=4096

# -----------------------------
# Health thresholds
# -----------------------------
CPU_WARNING=85
CPU_CRITICAL=95
MEMORY_WARNING=85
MEMORY_CRITICAL=95
DISK_WARNING=85
DISK_CRITICAL=95
LOAD_WARNING_PER_CPU=35.5
LOAD_CRITICAL_PER_CPU=40.00

# Space-separated mount points to monitor.
DISK_PATHS=/

# Comma-separated services. Missing services are ignored by default.
SERVICES=nginx,apache2,httpd,ssh,sshd,lshttpd,mysql
ALERT_ON_MISSING_SERVICE=false

# -----------------------------
# Web server logs
# -----------------------------
# Optional comma-separated override. The installer sets panel-specific defaults
# for new installs. No globbing or recursive per-vhost discovery is performed.
WEB_ERROR_LOGS=
NGINX_ERROR_LOG=/var/log/nginx/error.log
APACHE_ERROR_LOG=/var/log/apache2/error.log
APACHE_RHEL_ERROR_LOG=/var/log/httpd/error_log
WEB_ERROR_BATCH_THRESHOLD=1
# Maximum characters retained from each outgoing log sample.
MAX_LOG_SAMPLE_CHARS=600

# -----------------------------
# SSH/security
# -----------------------------
AUTH_LOG=/var/log/auth.log
AUTH_LOG_RHEL=/var/log/secure
SSH_FAILED_THRESHOLD=5
SSH_FAILED_WINDOW_SECONDS=300
# Bound in-memory/persisted failure tracking during a distributed brute-force attack.
SSH_FAILURE_TRACKED_IPS_MAX=1000
SSH_ALERT_SUCCESS=true
SSH_ALERT_FAILED_BURST=true
SSH_ALERT_ROOT_LOGIN=true

# Comma-separated CIDRs/IPs considered trusted.
# Example: 10.0.0.0/8,192.168.0.0/16,203.0.113.10
TRUSTED_SSH_NETWORKS=

# -----------------------------
# Kernel / OOM Killer & Crash Monitoring
# -----------------------------
KERNEL_MONITOR_ENABLED=true
KERNEL_LOG=/var/log/kern.log
KERNEL_LOG_RHEL=/var/log/messages
# Optional explicit comma-separated paths:
KERNEL_ERROR_LOGS=
# Fall back to journalctl -k if no physical kernel log files are found:
KERNEL_JOURNAL_FALLBACK=true

# -----------------------------
# Alerting / deduplication
# -----------------------------
ALERT_COOLDOWN_SECONDS=900
RECOVERY_ALERTS=true

# Select exactly one delivery channel: email or telegram.
ALERT_CHANNEL=email

# -----------------------------
# SMTP / Amazon SES SMTP
# -----------------------------
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=server-monitor@example.com
SMTP_TO=you@example.com
SMTP_TIMEOUT=20

# -----------------------------
# Telegram Bot API (used only when ALERT_CHANNEL=telegram)
# -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: topic/thread ID in a Telegram forum supergroup.
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_TIMEOUT=10

# -----------------------------
# Gemini (optional)
# -----------------------------
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8
# Bound response cost and notification size. Valid range: 1-2048.
GEMINI_MAX_OUTPUT_TOKENS=400
# Maximum AI analysis calls per minute (sliding window) to protect API quota.
GEMINI_RATE_LIMIT_PER_MINUTE=10

# -----------------------------
# Local files
# -----------------------------
STATE_DIR=/var/lib/server-ai-agent
LOG_FILE=/var/log/server-ai-agent/agent.log
LOG_LEVEL=INFO
