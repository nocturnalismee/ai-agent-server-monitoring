# -----------------------------
# Server identity
# -----------------------------
# Server name shown in alerts. Leave unset to auto-detect from system hostname.
# SERVER_NAME=prod-web-01
ENVIRONMENT=production

# Auto-detect OS distro (CloudLinux, Alma, Ubuntu) & Control Panel (cPanel, aaPanel, CyberPanel, etc.)
AUTO_DETECT_ENVIRONMENT=true
# Auto-discover installed services to eliminate false alerts for services not installed
AUTO_DETECT_SERVICES=true
# Capture real-time evidence (journalctl -u <service> or top CPU/RAM processes) when incidents occur
COLLECT_INCIDENT_EVIDENCE=true
EVIDENCE_LINES=15

# -----------------------------
# Monitoring intervals (seconds)
# -----------------------------
HEALTH_INTERVAL=60
LOG_INTERVAL=15
# Watchdog alert threshold (seconds). The agent refreshes a heartbeat every 30s;
# if it stops updating for longer than this, the watchdog service enabled by
# install.sh sends one alert (subject to ALERT_COOLDOWN_SECONDS).
HEARTBEAT_STALE_SECONDS=300
# Maximum log lines consumed from each monitored file per cycle.
MAX_LOG_LINES_PER_CYCLE=250
# Maximum characters retained from one physical log line. Oversized lines are
# consumed safely and marked as truncated; they are never held in full memory.
MAX_LOG_LINE_CHARS=4096

# -----------------------------
# Health thresholds
# -----------------------------
CPU_WARNING=85
CPU_CRITICAL=95
MEMORY_WARNING=85
MEMORY_CRITICAL=95
DISK_WARNING=85
DISK_CRITICAL=95
# 1-minute load average normalized per CPU core (load1 / cpu_count).
# Healthy is roughly <1.0; sustained >=2.0 per core indicates saturation.
LOAD_WARNING_PER_CPU=1.5
LOAD_CRITICAL_PER_CPU=2.5

# Space-separated mount points to monitor.
DISK_PATHS=/

# Comma-separated services. Missing services are ignored by default.
SERVICES=nginx,apache2,httpd,ssh,sshd,lshttpd,mysql
ALERT_ON_MISSING_SERVICE=false

# -----------------------------
# Web server logs
# -----------------------------
# Optional comma-separated override. The installer sets panel-specific defaults
# for new installs. No globbing or recursive per-vhost discovery is performed.
WEB_ERROR_LOGS=
NGINX_ERROR_LOG=/var/log/nginx/error.log
APACHE_ERROR_LOG=/var/log/apache2/error.log
APACHE_RHEL_ERROR_LOG=/var/log/httpd/error_log
WEB_ERROR_BATCH_THRESHOLD=1
# Maximum characters retained from each outgoing log sample.
MAX_LOG_SAMPLE_CHARS=600

# -----------------------------
# SSH/security
# -----------------------------
AUTH_LOG=/var/log/auth.log
AUTH_LOG_RHEL=/var/log/secure
SSH_FAILED_THRESHOLD=5
SSH_FAILED_WINDOW_SECONDS=300
# Bound in-memory/persisted failure tracking during a distributed brute-force attack.
SSH_FAILURE_TRACKED_IPS_MAX=1000
SSH_ALERT_SUCCESS=true
SSH_ALERT_FAILED_BURST=true
SSH_ALERT_ROOT_LOGIN=true

# Comma-separated CIDRs/IPs considered trusted.
# Example: 10.0.0.0/8,192.168.0.0/16,203.0.113.10
TRUSTED_SSH_NETWORKS=

# -----------------------------
# Kernel / OOM Killer & Crash Monitoring
# -----------------------------
KERNEL_MONITOR_ENABLED=true
KERNEL_LOG=/var/log/kern.log
KERNEL_LOG_RHEL=/var/log/messages
# Optional explicit comma-separated paths:
KERNEL_ERROR_LOGS=
# Fall back to journalctl -k if no physical kernel log files are found:
KERNEL_JOURNAL_FALLBACK=true

# -----------------------------
# Alerting / deduplication
# -----------------------------
ALERT_COOLDOWN_SECONDS=900
RECOVERY_ALERTS=true

# Select exactly one delivery channel: email or telegram.
ALERT_CHANNEL=telegram

# -----------------------------
# SMTP / Amazon SES SMTP
# -----------------------------
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=server-monitor@example.com
SMTP_TO=you@example.com
SMTP_TIMEOUT=20

# -----------------------------
# Telegram Bot API (used only when ALERT_CHANNEL=telegram)
# -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: topic/thread ID in a Telegram forum supergroup.
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_TIMEOUT=10

# -----------------------------
# Critical alert escalation (optional)
# -----------------------------
# Send serious incidents to a second, central channel in addition to the
# primary channel above (for example an ops-team supergroup). The primary
# channel still receives every alert; this one only gets WARNING/CRITICAL.
ESCALATION_CHANNEL=none
# Reuses TELEGRAM_BOT_TOKEN when left empty.
ESCALATION_TELEGRAM_BOT_TOKEN=
ESCALATION_TELEGRAM_CHAT_ID=
ESCALATION_TELEGRAM_MESSAGE_THREAD_ID=
ESCALATION_MIN_SEVERITY=CRITICAL

# -----------------------------
# AI Incident Analysis (Optional)
# -----------------------------
# Supported providers: deepseek, openai, claude, groq, kimi, openrouter, custom, gemini
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_API_KEY=
# Leave AI_MODEL blank for provider default, or specify custom model:
# deepseek: deepseek-chat
# openai: gpt-4o-mini
# claude: claude-3-5-haiku-20241022
# groq: llama-3.3-70b-versatile
# kimi: moonshot-v1-8k
# gemini: gemini-1.5-flash
AI_MODEL=
# Optional custom base URL (required only for AI_PROVIDER=custom or OpenAI-compatible proxies/Ollama):
# Example: https://api.deepseek.com/v1 or https://api.groq.com/openai/v1 or https://api.openai.com/v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=10
# Bound response cost and notification size. Valid range: 1-8192.
AI_MAX_OUTPUT_TOKENS=400
# Maximum AI analysis calls per minute (sliding window) to protect API quota.
AI_RATE_LIMIT_PER_MINUTE=10

# Legacy Gemini settings (still recognized if AI_* variables are not used):
# GEMINI_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# -----------------------------
# Local files
# -----------------------------
STATE_DIR=/var/lib/server-ai-agent
LOG_FILE=/var/log/server-ai-agent/agent.log
LOG_LEVEL=INFO
# text (human-readable, default) or json (one JSON object per line).
LOG_FORMAT=text