# ─────────────────────────────────────────────────────────────
# Per-server example for a multi-server Telegram deployment.
# Copy this file to each server, then set a unique SERVER_NAME and
# that server's own TELEGRAM_MESSAGE_THREAD_ID.
# Path on the server: /etc/server-ai-agent/server-ai-agent.env
# ─────────────────────────────────────────────────────────────

# ── Bot / destination (identical on every server) ────────────
ALERT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890

# ── Per-server identity ──────────────────────────────────────
# Topic created for THIS server in the supergroup.
TELEGRAM_MESSAGE_THREAD_ID=42

# Unique, stable name shown in the alert header/footer.
# Use a hostname or logical name, e.g. whm-cust123 / vps-sg-01.
SERVER_NAME=whm-cust123
ENVIRONMENT=production

# ── Behaviour (sane fleet defaults) ──────────────────────────
AUTO_DETECT_ENVIRONMENT=true
AUTO_DETECT_SERVICES=true
COLLECT_INCIDENT_EVIDENCE=true

ALERT_COOLDOWN_SECONDS=900
RECOVERY_ALERTS=true

# INFO/RECOVERY alerts are silent; WARNING/CRITICAL make sound.
HEALTH_INTERVAL=60
LOG_INTERVAL=15

# ── Optional AI enrichment ───────────────────────────────────
AI_ENABLED=false
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your-deepseek-api-key
# AI_MODEL=deepseek-chat
